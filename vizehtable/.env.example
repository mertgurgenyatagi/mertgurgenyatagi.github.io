# Copy to .env.local and fill in from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
# .env.local is gitignored; this file is not.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Realtime Database, for chat presence and typing indicators. Free on Spark.
# `firebase apps:sdkconfig WEB` does not always include this one — read it from
# the console (Realtime Database → Data, the URL above the tree) if missing.
VITE_FIREBASE_DATABASE_URL=

# Photo uploads need Firebase Storage, which needs the Blaze plan.
# Leave unset (or anything but "true") to hide the photo affordance entirely.
VITE_PHOTOS_ENABLED=false
