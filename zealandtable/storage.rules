rules_version = '2';

/**
 * Profile photos only. The forum is text-only in this build, so there is no
 * forum-images path to secure.
 *
 * Every upload gets a fresh timestamped path (`{uid}-{ms}`) rather than a
 * fixed one per user, which is what makes an immutable cache header safe: a
 * cached URL is either current or an orphan nobody links to, never stale.
 */
service firebase.storage {
  match /b/{bucket}/o {
    match /profile-photos/{fileName} {
      // Public read — a participant's photo appears next to their name on the
      // landing page, which a logged-out visitor sees.
      allow read: if true;

      allow write: if request.auth != null
        && fileName.matches(request.auth.uid + '-[0-9]+')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');

      allow delete: if request.auth != null
        && fileName.matches(request.auth.uid + '-[0-9]+');
    }

    match /{allOther=**} {
      allow read, write: if false;
    }
  }
}
