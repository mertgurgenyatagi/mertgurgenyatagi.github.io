{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    // A composite project can't set noEmit, so its output is sent somewhere
    // gitignored instead. The parent project leaves this unset, which is why
    // a stray vite.config.js and vite.config.d.ts regenerate at its repo root
    // on every build.
    "noEmit": false,
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
